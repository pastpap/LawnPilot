# Base URL for LawnPilot backend API root (without trailing slash)
# Example: http://localhost:8080/api/v1
EDGE_SIM_API_BASE_URL=http://localhost:8080/api/v1

# Telemetry emission interval per mower stream in milliseconds
EDGE_SIM_INTERVAL_MS=5000

# Role header used for fleet/mower registration + telemetry events
# Allowed values in backend: ADMIN, OPERATOR, VIEWER
# Use ADMIN or OPERATOR because telemetry ingestion is a mutation endpoint
EDGE_SIM_ROLE=OPERATOR

# Seed mower source. Can be a .json file or the existing frontend TS seed file.
EDGE_SIM_MOWERS_FILE=../frontend/src/data/telemetry.ts

# Optional comma-separated tenant filter. Empty means all tenants in seed data.
EDGE_SIM_TENANT_FILTER=

# Set true to skip HTTP calls and only print generated events
EDGE_SIM_DRY_RUN=false

# Optional safety stop for local tests; empty means run continuously
EDGE_SIM_MAX_TICKS=
