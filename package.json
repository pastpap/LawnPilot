{
    "name": "lawnpilot-phase5",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "dev": "concurrently -k -n backend,frontend -c cyan,green \"cd lawnpilot && ./gradlew bootRun\" \"cd frontend && npm run dev\"",
        "dev:backend": "cd lawnpilot && ./gradlew bootRun",
        "start:backend": "./lawnpilot/gradlew -p lawnpilot bootRun",
        "dev:frontend": "cd frontend && npm run dev",
        "build:frontend": "cd frontend && npm run build"
    },
    "devDependencies": {
        "concurrently": "^9.0.1"
    }
}